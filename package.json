{
  "name": "campus-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && node scripts/build-icons.mjs && vite build && node scripts/build-pwa.mjs && node scripts/build-compressed.mjs && vite build --config vite.worker.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:api": "node --watch server/local.mjs",
    "start": "node server/local.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "dev:web": "vite"
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "drizzle-orm": "^0.45.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
