# The implementation intentionally rejects every mode except demo.
INTEGRATION_MODE=demo
PORT=8787
# Preferred behind a deployment proxy: your actual public HTTPS origin, no path.
# CANONICAL_ORIGIN=https://your-service.example
# Proxy headers are ignored unless explicitly trusted. Options: false (default),
# loopback, comma-separated exact proxy IPs, or true for proxy-only ingress.
# TRUST_PROXY=true requires the edge to overwrite X-Forwarded-Proto and block
# direct access to Node. Only a single http/https value is accepted, not hop lists.
TRUST_PROXY=false
# Optional additional frontend origins. Production does not allow localhost by default.
# ALLOWED_ORIGINS=https://your-frontend.example
# School and robot credentials are not configured. Never put secret keys in
# VITE_* variables: Vite embeds those values in browser JavaScript.
